<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base XML theme used only for the launch screen before Compose takes over.
         The actual UI theming (multiple light themes, no dark mode) is driven from Compose. -->
    <style name="Theme.InsightFaceRecognizer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
